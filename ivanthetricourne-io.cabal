cabal-version:      2.4
name:               ivanthetricourne-io
version:            1.0.0
synopsis:           Carl J. Factora's blog and portfolio site
description:        The Hakyll generator that builds https://ivanthetricourne.io.
license:            MIT
license-file:       LICENSE
author:             Carl J. Factora
maintainer:         cfactora93@gmail.com
build-type:         Simple
extra-source-files: README.md

executable site
    main-is:          site.hs
    hs-source-dirs:   src
    other-modules:    Site.Config
                      Site.Context
                      Site.Resume
    build-depends:    base    >=4.14 && <5
                    , aeson   >=2.0  && <2.3
                    , filepath
                    , hakyll  >=4.16 && <4.17
                    -- For the reader/writer option tweaks in site.hs; the
                    -- version is whatever hakyll already pulls in.
                    , pandoc  >=3.0  && <3.2
                    , text
                    , time
                    , yaml    >=0.11 && <0.12
    default-language: Haskell2010
    ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
